\@writefile{lof}{\contentsline {figure}{\numberline {39}{\ignorespaces Matriz de confusão do LGBM sobre o conjunto de teste. As confusões mais expressivas ocorreram entre RQRQ\_{RQ} e RQRQ\_{RQ\_Q} (62 amostras) e entre RQ\_{RQ} e RQRQ\_{RQ} (67 amostras). A classe R\_{RQ} apresentou 119 erros totais, o maior valor entre as classes para este modelo.}}{84}{figure.3.39}\protected@file@percent }
\newlabel{figura39}{{39}{84}{Fonte: Imagem gerada pelo script de treinamento}{figure.3.39}{}}
